// Color por nivel de vulnerabilidad
const COLOR_NIVEL = { 'Alto':'#e23b2f', 'Medio':'#a0a200', 'Bajo':'#12b21a' };

let asuntoOriginal='', cuerpoOriginal='', datosRespuesta=null;

// ── VALIDACIÓN ────────────────────────────────────────────────
document.getElementById('input-email').addEventListener('input', validarPaso1);
document.getElementById('input-nombre').addEventListener('input', validarPaso1);
document.getElementById('input-region').addEventListener('change', ()=>{ cargarPerfil(); validarPaso1(); });
document.getElementById('check-consentimiento').addEventListener('change', validarPaso1);

// Tooltip toggle (clic en la "i")
document.getElementById('info-icon').addEventListener('click', function(e){
  e.stopPropagation();
  document.getElementById('badge-wrap').classList.toggle('show-tip');
});
document.addEventListener('click', ()=> document.getElementById('badge-wrap').classList.remove('show-tip'));

function validarPaso1(){
  const ok = document.getElementById('input-nombre').value.trim() &&
             document.getElementById('input-region').value &&
             document.getElementById('check-consentimiento').checked;
  document.getElementById('btn-paso1').disabled = !ok;
}

// ── ESCALA DE VULNERABILIDAD ─────────────────────────────────
function cargarPerfil(){
  const region = document.getElementById('input-region').value;
  const d = VULN[region];
  const box = document.getElementById('vuln-box');
  if(!d){ box.style.display='none'; return; }

  const color = COLOR_NIVEL[d.nivel] || '#a0a200';
  box.style.setProperty('--lvl', color);

  document.getElementById('vuln-title').textContent = `Nivel de vulnerabilidad de la región ${region}`;

  const cur = Math.round(d.score);
  let nums = '';
  for(let i=0;i<=10;i++){
    const cls = i===cur ? 'cur' : (i<cur ? 'past' : '');
    nums += `<span class="${cls}">${i}</span>`;
  }
  document.getElementById('escala-nums').innerHTML = nums;
  document.getElementById('escala-fill').style.width = (d.score/10*100) + '%';

  const nivelTxt = { 'Alto':'Alta', 'Medio':'Media', 'Bajo':'Baja' }[d.nivel] || d.nivel;
  document.getElementById('vuln-badge-text').textContent = `Vulnerabilidad ${nivelTxt}`;

  box.style.display='block';
}

// ── PASO 1 → 2 ───────────────────────────────────────────────
async function irAPaso2(){
  const nombre = capitalizar(document.getElementById('input-nombre').value.trim());
  const region = document.getElementById('input-region').value;
  const dni    = document.getElementById('input-dni').value.trim();
  const email_ciudadano = document.getElementById('input-email').value.trim();
  const consentimiento = document.getElementById('check-consentimiento').checked;

  document.getElementById('btn-paso1').disabled = true;
  document.getElementById('btn-paso1').innerHTML = '<span class="spinner"></span> Preparando...';

  const dir = DIRECTORIO[region] || {};
  const gobernador = dir.gobernador || 'Gobernador/a Regional';

  try {
    const res = await fetch(N8N_WEBHOOK, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ nombre_ciudadano:nombre, region, dni, email_ciudadano, consentimiento })
    });
    const data = await res.json();
    datosRespuesta = data;

    if(data.ok && data.cuerpo){
      asuntoOriginal = data.asunto || '';
      cuerpoOriginal = data.cuerpo || '';
    } else {
      throw new Error('fallback');
    }
  } catch(e){
    // Fallback local
    asuntoOriginal = `Solicitud de información — Plan de prevención FEN y ejecución PP 0068 · Región ${region}`;
    cuerpoOriginal = generarCuerpo(nombre, region, dni, gobernador);
    datosRespuesta = {
      destinatario: dir.email_gob || '',
      cc_ppto:      dir.email_ppto || '',
      cc_riesgo:    dir.email_riesgo || '',
      asunto:       asuntoOriginal,
      cuerpo:       cuerpoOriginal
    };
  }

  document.getElementById('editor-asunto').value = asuntoOriginal;
  document.getElementById('editor-cuerpo').value = cuerpoOriginal;
  irPaso(2);
  document.getElementById('btn-paso1').disabled = false;
  document.getElementById('btn-paso1').textContent = 'Preparar mi correo';
}

function capitalizar(str){
  return str.replace(/\b\w/g, c => c.toUpperCase());
}

function generarCuerpo(nombre, region, dni, gobernador){
  const hoy = new Date().toLocaleDateString('es-PE',{day:'2-digit',month:'long',year:'numeric'});
  return `Señor/a
${gobernador}
Gobernador/a Regional de ${region}
Presente.—

Yo, ${nombre}${dni ? ', DNI ' + dni : ''}, ciudadano/a de la región ${region}, al amparo del derecho de petición reconocido en el artículo 2, inciso 20 de la Constitución Política del Perú y en la Ley N.° 27444, me dirijo a usted para solicitar lo siguiente:

1. Que se me informe sobre el plan de prevención y reducción de riesgos ante el Fenómeno El Niño de la región ${region}, su estado de implementación y las obras priorizadas para la presente temporada.

2. El estado de ejecución del Programa Presupuestal 0068 (Reducción de la vulnerabilidad y atención de emergencias por desastres) asignado al Gobierno Regional de ${region} para el año fiscal en curso.

3. El cronograma de obras y acciones de prevención priorizadas antes del inicio de la temporada de lluvias.

Solicito respuesta escrita en el plazo de 30 días hábiles, conforme al artículo 123 del TUO de la Ley N.° 27444. De no recibir respuesta, me reservo el derecho de presentar queja ante la Defensoría del Pueblo.

Atentamente,

${nombre}
${dni ? 'DNI: ' + dni : ''}
${region}, ${hoy}`;
}

// ── IMPRIMIR ──────────────────────────────────────────────────
function descargarImprimir(){
  const asunto = document.getElementById('editor-asunto').value;
  const cuerpo = document.getElementById('editor-cuerpo').value;
  const region = document.getElementById('input-region').value;
  const html = `<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8">
  <title>Solicitud formal — ${region}</title>
  <style>body{font-family:Georgia,serif;max-width:700px;margin:3rem auto;padding:2rem;color:#111;line-height:1.7;}
  h2{font-size:1rem;color:#555;margin-bottom:.5rem;}
  .asunto{background:#f5f5f5;padding:.75rem 1rem;border-radius:4px;margin-bottom:2rem;font-size:.9rem;}
  pre{white-space:pre-wrap;font-family:Georgia,serif;font-size:.95rem;}
  @media print{body{margin:1rem;}}</style></head>
  <body><h2>Asunto:</h2><div class="asunto">${asunto}</div><pre>${cuerpo}</pre></body></html>`;
  const blob = new Blob([html], {type:'text/html'});
  const url  = URL.createObjectURL(blob);
  const w    = window.open(url,'_blank');
  if(w) setTimeout(()=> w.print(), 800);
}

// ── ABRIR GMAIL ───────────────────────────────────────────────
function abrirGmail(){
  const asunto = document.getElementById('editor-asunto').value;
  const cuerpo = document.getElementById('editor-cuerpo').value;
  const region = document.getElementById('input-region').value;
  const dir    = DIRECTORIO[region] || {};

  const to   = datosRespuesta?.destinatario || dir.email_gob || '';
  const cc_parts = [
    datosRespuesta?.cc_ppto  || dir.email_ppto  || '',
    datosRespuesta?.cc_riesgo|| dir.email_riesgo|| ''
  ].filter(Boolean);
  const cc = cc_parts.join(',');

  const params = new URLSearchParams({view:'cm',fs:'1',to,su:asunto,body:cuerpo});
  if(cc) params.append('cc', cc);
  window.open(`https://mail.google.com/mail/?${params.toString()}`, '_blank');

  document.getElementById('confirmacion-datos').innerHTML =
    `<strong>Región:</strong> ${region}<br>
     <strong>Gobernador/a:</strong> ${dir.gobernador || '—'}<br>
     <strong>Destinatario principal:</strong> ${to || '(pendiente de verificación)'}<br>
     <strong>Con copia a:</strong> ${cc || '—'}<br>
     <strong>Recuerda:</strong> Guarda el número de registro de mesa de partes.`;
  irPaso(3);
}

// ── NAVEGACIÓN ────────────────────────────────────────────────
function irPaso(n){
  [1,2,3].forEach(i=>{
    document.getElementById(`paso-${i}`).classList.toggle('activa', i===n);
    const tab = document.getElementById(`tab-${i}`);
    tab.classList.remove('activo','reached');
    if(i<=n) tab.classList.add('reached');
    if(i===n) tab.classList.add('activo');
  });
}
function irAPaso1(){ irPaso(1); }

function reiniciar(){
  document.getElementById('input-email').value='';
  document.getElementById('input-nombre').value='';
  document.getElementById('input-region').value='';
  document.getElementById('input-dni').value='';
  document.getElementById('check-consentimiento').checked=false;
  document.getElementById('vuln-box').style.display='none';
  document.getElementById('btn-paso1').disabled=true;
  datosRespuesta=null;
  irPaso(1);
}
</script>
</body>
</html>
